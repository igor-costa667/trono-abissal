  {
   "id": "nao-so-mas",
   "regex": "(?i)\\bn[aã]o s[oó]\\b[^.!?\\n]{2,80}\\bmas (?:tamb[eé]m|ainda)\\b",
   "nome": "\"Não só X, mas também Y\"",
   "conserto": "Duas frases, ou fique com a metade mais forte."
  },
  {
   "id": "nao-se-trata",
   "regex": "(?i)\\bn[aã]o se trata de [^.!?\\n]{2,60}[.,]\\s*(?:se trata|trata-se)\\b",
   "nome": "\"Não se trata de X. Se trata de Y\"",
   "conserto": "Comece pelo Y."
  },
  {
   "id": "trio",
   "regex": "(?i)\\b\\w+, \\w+ e \\w+\\b[^.!?\\n]{0,20}[.!]",
   "nome": "Lista de três por reflexo",
   "conserto": "Fique com a palavra mais forte. Três por hábito soa robô."
  },
  {
   "id": "pergunta-retorica",
   "regex": "(?m)^\\s*(?:O resultado|A resposta|O motivo|O segredo|A verdade|E o melhor)\\?\\s*$",
   "nome": "Pergunta de uma palavra (\"O resultado?\")",
   "conserto": "Diga o resultado direto."
  },
  {
   "id": "preambulo",
   "regex": "(?i)\\b(?:nesse|neste) v[ií]deo\\b|\\bhoje eu vou (?:te )?(?:mostrar|ensinar)\\b|\\bvem comigo que\\b",
   "nome": "Introdução de vídeo",
   "conserto": "Comece pela parte boa."
  },
  {
   "id": "lista-emoji",
   "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF\\u2600-\\u27BF]\\s+\\S",
   "nome": "Lista com emoji no começo de cada linha",
   "conserto": "Use hífen ou texto corrido."
  },
