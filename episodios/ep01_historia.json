    {"quem": "mago", "txt": "Esse é o escolhido? Um menino franzino de pijama?", "expressao": "bravo", "pose": "apontando", "etiqueta": {"id": "mago", "txt": "Mago da corte"}},
    {"quem": "ren", "txt": "Pijama não. É moletom. Edição limitada.", "expressao": "bravo"},
    {"quem": "narrador", "txt": "Os magos riram. Todos, menos um."},
